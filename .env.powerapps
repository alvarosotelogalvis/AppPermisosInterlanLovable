# Build para Power Apps code apps en modo demostración (npm run build:powerapps).
# Sin secretos: deja vacías las variables de Supabase para que NO se incluyan en el build
# y activa el modo solo-demo (datos de prueba en memoria, sin base de datos).
VITE_DEMO_ONLY=true
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_DEMO_CREDENTIALS={}
